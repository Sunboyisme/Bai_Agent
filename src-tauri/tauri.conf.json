{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bai Agent",
  "version": "0.1.0",
  "identifier": "com.qinbai.baiagent.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5186",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bai · 个人助手",
        "width": 1280,
        "height": 850,
        "minWidth": 700,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8766; font-src 'self' data:"
    }
  },
  "bundle": { "active": false }
}
